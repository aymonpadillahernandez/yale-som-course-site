# Copy to .env in this folder, or keep one .env in the parent workspace folder.
# agent.py loads backend/../.env (this folder) first, then the parent folder's .env.
# Never commit a real key.

PORTKEY_API_KEY=your_portkey_api_key_here

# Optional — defaults to https://api.portkey.ai/v1
PORTKEY_BASE_URL=https://api.portkey.ai/v1
